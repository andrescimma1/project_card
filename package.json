{
  "name": "digimon-dcb-remake",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Faithful 1:1 rules reproduction of Digimon Digital Card Battle (PS1) with a modern UI.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "extract:cards": "tsx tools/extract-cards.ts",
    "extract:decks": "tsx tools/extract-decks.ts",
    "extract:art": "tsx tools/extract-art.ts",
    "extract:progression": "tsx tools/extract-progression.ts",
    "extract:scripts": "tsx tools/extract-scripts.ts"
  },
  "dependencies": {
    "motion": "^12.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  }
}
